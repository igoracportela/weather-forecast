# Copy to .env and adjust. Every variable is optional, and no API keys are needed.
#
# `docker compose` reads .env only to fill in ${SECRET_KEY_BASE} in
# docker-compose.yml; the other values there are set in the file itself.
# Rails does not load .env, so for `bin/rails server` or `bin/rspec`, export
# the variables in your shell instead.

# Signs cookies. If empty, bin/docker-entrypoint generates one per boot, which
# is fine for a single container. Set it when running several replicas:
#   bin/rails secret
SECRET_KEY_BASE=

# Shared cache. Unset means the in-process :memory_store (32 MB).
# Compose sets redis://redis:6379/0 for the bundled Redis.
# REDIS_URL=redis://localhost:6379/1

# Production only. Defaults: TLS forced, info logging.
# RAILS_FORCE_SSL=false
# RAILS_LOG_LEVEL=info

# Puma. Defaults: 3 threads, port 3000, single process.
# RAILS_MAX_THREADS=5
# WEB_CONCURRENCY=2
# PORT=3000
